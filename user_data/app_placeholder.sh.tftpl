#!/bin/bash
# 앱 서버(nginx / shop-app / dashboard) 첫 부팅 스크립트.
# 실제 앱 이미지가 ECR 에 올라가기 전까지, 같은 포트에서 /health 에 200 을 주는
# 자리표시자 컨테이너를 띄워 ALB 헬스체크와 네트워크 경로를 먼저 검증한다.
# 실제 배포(GitHub Actions)는 같은 이름의 컨테이너를 지우고 ECR 이미지로 다시 띄운다.
set -euxo pipefail
exec > >(tee /var/log/user-data.log) 2>&1

${docker_install}

dnf install -y openssl
# 점검용 도구는 실패해도 전체 설치를 막지 않는다.
dnf install -y ${extra_packages} || true

mkdir -p /opt/placeholder/certs
openssl req -x509 -nodes -newkey rsa:2048 -days 825 \
  -keyout /opt/placeholder/certs/tls.key \
  -out /opt/placeholder/certs/tls.crt \
  -subj "/CN=${container_name}"

cat > /opt/placeholder/default.conf <<'CONF'
server {
  listen ${port} ssl;
  ssl_certificate     /etc/nginx/certs/tls.crt;
  ssl_certificate_key /etc/nginx/certs/tls.key;
  default_type text/plain;

  location = /health { return 200 'ok'; }
  location /          { return 200 'placeholder: ${container_name}'; }
}
CONF

docker run -d --name ${container_name} --restart unless-stopped \
  -p ${port}:${port} \
  -v /opt/placeholder/default.conf:/etc/nginx/conf.d/default.conf:ro \
  -v /opt/placeholder/certs:/etc/nginx/certs:ro \
  ${placeholder_image}
