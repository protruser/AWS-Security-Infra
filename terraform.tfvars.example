region  = "ap-northeast-2"
project = "wonny-sec"

# 관리자 화면 접속을 허용할 실제 공인 IP/32로 변경
admin_cidrs = ["203.0.113.10/32"]

# 현재 도메인이 없으면 false 유지.
# 이 경우 shop/admin ALB 기본 DNS 주소를 output으로 사용합니다.
enable_custom_domain = false
route53_zone_id      = ""
shop_domain          = ""
admin_domain         = ""

enable_security_services = true

# Interface Endpoint는 비용이 발생하므로 처음에는 false 권장
enable_vpc_endpoints = false

force_destroy_buckets = false

# GitHub Actions OIDC를 이미 AWS 계정에 만들어 둔 경우에만 채움. 여러 레포를
# 동시에 신뢰할 수 있음(리스트).
# 주의: 각 항목은 단순 "owner/repo"가 아니라 실제 OIDC 토큰의 sub 클레임과
# 정확히 일치해야 함. GitHub가 이름 대신(또는 이름과 함께) 불변 숫자 ID를 sub에 넣는
# 경우가 있어서(owner@ownerId/repo@repoId 형식), "owner/repo"만 넣으면
# AssumeRoleWithWebIdentity가 거부될 수 있음. 워크플로에서 OIDC 토큰의 sub 클레임을
# 직접 찍어보고(예: 이 레포 .github/workflows/*.yml의 "Inspect OIDC claims" 스텝 참고)
# 그 값을 그대로 넣을 것.
github_repositories       = []
github_oidc_provider_arn = ""
